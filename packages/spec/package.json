{
  "name": "@toucan/spec",
  "version": "0.1.0",
  "private": true,
  "description": "Shared SceneSpec contract: zod schema + TypeScript types for the element+edge+timeline IR. Imported by the renderer and (later) the frontend; mirrored by the Spring Boot validator.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "tsx": "4.19.2",
    "typescript": "^5.5.0"
  }
}
